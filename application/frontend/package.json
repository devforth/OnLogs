    "@storybook/addon-links": "^6.5.12",
    "@storybook/builder-vite": "^0.2.3",
    "@storybook/svelte": "^6.5.12",
    "@storybook/testing-library": "^0.0.13",
    "@sveltejs/vite-plugin-svelte": "^1.0.2",
    "esbuild": "^0.28.1",
    "eslint-plugin-svelte3": "^4.0.0",
    "fs-extra": "^11.4.0",
    "jsdom": "^30.0.1",
    "sass": "^1.102.0",
